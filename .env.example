# HTTP-порт (ONREZA обычно задаёт сам)
PORT=3000

# PostgreSQL (обязательно для production)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Секретный ключ для Roblox → API (только сервер!)
# Сгенерируйте длинную случайную строку, например:
# openssl rand -hex 32
STATUS_API_KEY=change_me_to_a_long_random_secret

# Через сколько секунд без обновления статус считается устаревшим
STALE_AFTER_SECONDS=120

# Отключить SSL к PostgreSQL (только если провайдер требует)
# PGSSLMODE=disable
